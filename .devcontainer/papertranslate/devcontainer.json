{
  "name": "PaperTranslate",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "forwardPorts": [
    8000
  ],
  "portsAttributes": {
    "8000": {
      "label": "PaperTranslate",
      "onAutoForward": "notify"
    }
  },
  "secrets": {
    "OPENAI_API_KEY": {
      "description": "Optional for the built-in sample. Used on the server to translate and narrate your papers."
    }
  },
  "remoteEnv": {
    "PT_TRUST_PRIVATE_CODESPACE": "1",
    "OPENAI_TTS_MODEL": "gpt-realtime-2.1-mini"
  },
  "postCreateCommand": "bash PaperTranslate/scripts/setup-codespace.sh",
  "postStartCommand": "bash PaperTranslate/scripts/start-codespace.sh"
}
